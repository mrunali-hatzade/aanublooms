{
  "name": "aanublooms-crochet-studio",
  "version": "1.0.0",
  "description": "AanuBlooms - Boutique Handcrafted Crochet & Floral E-Commerce Platform",
  "scripts": {
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node backend/server.js",
    "build": "npm run build --prefix frontend"
  },
  "keywords": [
    "crochet",
    "ecommerce",
    "handmade",
    "blooms",
    "amigurumi",
    "yarn"
  ],
  "author": "AanuBlooms Studio",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
